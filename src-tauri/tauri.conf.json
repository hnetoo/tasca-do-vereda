{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tasca Do VEREDA",
  "version": "1.1.80",
  "identifier": "com.tascadovereda.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tasca Do VEREDA",
        "width": 1200,
        "height": 800,
        "visible": false,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
        "wix": {
            "language": ["pt-PT", "en-US"]
        }
    }
  },
  "plugins": {
      "sql": {
          "preload": ["sqlite:tasca.db"]
      }
  }
}
