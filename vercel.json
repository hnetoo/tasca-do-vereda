{
  "rewrites": [
    {"source": "/owner/mobile", "destination": "/owner/mobile"},
    {"source": "/owner/mobile/login", "destination": "/owner/mobile/login"},
    {"source": "/owner/mobile/(.*)", "destination": "/owner/mobile/$1"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate"},
      {"key": "Pragma", "value": "no-cache"},
      {"key": "Expires", "value": "0"}
    ]},
    {"source": "/owner/mobile/(.*)", "headers": [
      {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"},
      {"key": "Pragma", "value": "no-cache"},
      {"key": "Expires", "value": "0"}
    ]}
  ]
}
